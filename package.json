{
  "name": "kusto-cluster-health",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "universal-app",
    "displayName": "Universal App",
    "description": "A lean React + Vite starter that grows into anything. A built-in capability router reads what you ask for, then enables the right Rayfin services, installs the right modules, and activates the right skills, from sign-in and CRUD data models to Graphein charts and Fabric analytics dashboards."
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "dev:local": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "wait-on http-get://localhost:3001/api/healthz && vite",
    "preview": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "check:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "rayfin:up": "rayfin up",
    "pack:add": "node scripts/scaffold.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@microsoft/rayfin-auth-provider-fabric": "^1.35.0",
    "@microsoft/rayfin-client": "^1.35.0",
    "@microsoft/rayfin-core": "^1.35.0",
    "@microsoft/rayfin-functions": "^1.35.0",
    "@tailwindcss/vite": "^4.1.11",
    "express": "^5.2.1",
    "graphein": ">=0.16.0",
    "lucide-react": "^1.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.35.0",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.8",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "@azure/msal-node": {
      "uuid": "11.1.1"
    },
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "8.8.0"
    },
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/propagator-jaeger": "2.11.0"
  }
}
